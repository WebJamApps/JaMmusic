{
  "name": "jammusic",
  "version": "2.33.1",
  "description": "joshandmariamusic.com",
  "main": "dist/index.html",
  "repository": {
    "url": "git+ssh://git@github.com/WebJamApps/JaMmusic.git",
    "type": "git"
  },
  "author": "https://github.com/orgs/WebJamApps/teams/handlersandkickers",
  "engines": {
    "node": "26.x"
  },
  "files": [
    "vite.config.ts",
    "src/",
    "public/"
  ],
  "keywords": [
    "React",
    "Typescript",
    "Vite",
    "Vitest"
  ],
  "license": "MIT",
  "scripts": {
    "install:prod": "npm run cleanup && npm install --only=prod",
    "dev": "DEV_HTTPS=true vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test:stylelint": "stylelint \"src/styles/**/*.scss\"",
    "lint:fix": "eslint . --fix",
    "test:lint-fix": "npm run test:stylelint && npm run lint:fix",
    "test:lint": "npm run test:stylelint && eslint .",
    "jscpd": "jscpd src",
    "test": "npm run test:lint && npm run typecheck && npm run jscpd && npm run test:unit",
    "test:unit": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:unit-u": "TZ=UTC vitest run -u",
    "cleanup": "rm -rf yarn.lock && rm -rf package-lock.json && rm -rf node_modules",
    "cleaninstall": "npm install -g npm@latest && npm run cleanup && npm install",
    "smoketest": "npm ci --omit=dev",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@react-oauth/google": "^0.13.5",
    "@tinymce/tinymce-react": "^6.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-slick": "^0.23.13",
    "@types/redux-logger": "^3.0.13",
    "@types/socketcluster-client": "^20.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "crypto-browserify": "^3.12.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "events": "^3.3.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-sslify": "^1.2.0",
    "html-react-parser": "^6.1.9",
    "jwt-simple": "^0.6.1",
    "mermaid": "^12.3.0",
    "plyr": "^3.8.5",
    "plyr-react": "^6.0.0",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.2.0",
    "react-zoom-pan-pinch": "4.2.0",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "sass": "^1.108.1",
    "slick-carousel": "^2.0.0",
    "socketcluster-client": "^21.0.0",
    "stream-browserify": "^3.0.0",
    "swagger-ui-react": "^5.34.1",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "vite": "^8.3.7",
    "vite-plugin-checker": "^1.0.0",
    "vm-browserify": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.4.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.7",
    "archiver": "^7.0.1",
    "unzipper": "^0.12.3",
    "katex": "^0.18.2",
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0",
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "ts-api-utils": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "unrs-resolver@1.11.1": true
  }
}
